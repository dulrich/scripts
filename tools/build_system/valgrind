#!/bin/sh
# >>> shguard modes=exec (generated by shell-disposition-gate --guard; do not edit)
case $(realpath -- "$0" 2>/dev/null) in */'valgrind') _shguard_m='exec' ;; *) if [ "${SHGUARD_MODE-}" = 'pipe' ]; then _shguard_m='pipe'; else _shguard_m='source'; fi ;; esac
# shellcheck disable=SC2317
case $_shguard_m in
  exec) unset _shguard_m ;;
  *) printf '%s: refusing %s invocation (supports: exec; pipe callers set SHGUARD_MODE=pipe)\n' 'valgrind' "$_shguard_m" >&2; unset _shguard_m; return 1 2>/dev/null || exit 1 ;;
esac
# <<< shguard
for _a in "$@"; do case "$_a" in --help)
	printf 'usage: %s %s\n' "${0##*/}" '<program> [args]'
	printf '%s\n' 'Run a program under valgrind with full leak checking.'
	exit 0;; esac; done
# Generated copies carry no build-id helper; answer the flags only where it exists.
_bid="$(dirname "$(realpath "$0")")/../../util/lib/build-id.sh"
# shellcheck source=util/lib/build-id.sh
[ -r "$_bid" ] && { . "$_bid"; build_flags "$0" "$@"; }
set -eu

# shellcheck disable=SC2068 # intentional word splitting of the program arguments, as before
 valgrind --leak-check=full --show-leak-kinds=all --error-limit=no --track-origins=yes $@
