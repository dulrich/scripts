# Colorscheme converted from .Xresources

foreground = #c5c8c6
background = #000000
cursor-color = #c5c8c6

palette = 0=#282a2e
palette = 1=#a54242
palette = 2=#649440
palette = 3=#de935f
palette = 4=#5f819d
palette = 5=#85678f
palette = 6=#5e8d87
palette = 7=#707880
palette = 8=#373b41
palette = 9=#cc6666
palette = 10=#8abd68
palette = 11=#f0c674
palette = 12=#81a2be
palette = 13=#b294bb
palette = 14=#8abeb7
palette = 15=#c5c8c6


# Font

font-family = Bitstream Vera Sans Mono
font-family-bold = Bitstream Vera Sans Mono
font-family-italic = Bitstream Vera Sans Mono
font-family-bold-italic = Bitstream Vera Sans Mono
font-size = 14


shell-integration-features = ssh-terminfo,ssh-env


# Window / appearance

window-padding-x = 2
window-padding-y = 2

gtk-titlebar = false
window-decoration = false

cursor-style = block
cursor-style-blink = true

scrollback-limit = 10240

# Your urxvt background had alpha:
# URxvt*background: rgba:0000/0000/0000/cccc
#
# cccc / ffff ~= 80% opacity.
# Start opaque first. Enable this only if you want the old transparency behavior.
#
background-opacity = 0.8

command = zellij -l welcome


# Keybinds

# CDE owns windows, panes and stacks, so ghostty's tab/split/window defaults are cleared
# (they also stole Alt+1..9, Ctrl+Tab, Ctrl+Enter etc. from TUIs). Only this whitelist is bound;
# Ctrl+, (open config in Xed) stays unbound. List the defaults: ghostty +list-keybinds --default
keybind = clear

# Clipboard
keybind = copy=copy_to_clipboard:mixed
keybind = paste=paste_from_clipboard
keybind = ctrl+insert=copy_to_clipboard:mixed
keybind = shift+insert=paste_from_selection
keybind = ctrl+shift+c=copy_to_clipboard:mixed
keybind = ctrl+shift+v=paste_from_clipboard

# Font size
keybind = ctrl+==increase_font_size:1
keybind = ctrl++=increase_font_size:1
keybind = ctrl+-=decrease_font_size:1
keybind = ctrl+0=reset_font_size

# Scrollback and prompts
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
keybind = shift+home=scroll_to_top
keybind = shift+end=scroll_to_bottom
keybind = ctrl+shift+page_up=jump_to_prompt:-1
keybind = ctrl+shift+page_down=jump_to_prompt:1

# Selection and search
keybind = shift+arrow_left=adjust_selection:left
keybind = shift+arrow_right=adjust_selection:right
keybind = shift+arrow_up=adjust_selection:up
keybind = shift+arrow_down=adjust_selection:down
keybind = ctrl+shift+a=select_all
keybind = ctrl+shift+f=start_search
keybind = escape=end_search

# Config
keybind = ctrl+shift+,=reload_config

# Optional: command palette, inspector, screen-to-file
keybind = ctrl+shift+p=toggle_command_palette
keybind = ctrl+shift+i=inspector:toggle
keybind = super+ctrl+shift+j=write_screen_file:copy,plain
keybind = ctrl+shift+j=write_screen_file:paste,plain
keybind = ctrl+alt+shift+j=write_screen_file:open,plain

# Per-host overrides (optional; ignored when absent): ~/.config/ghostty/local, e.g. `command =` to reset to the login shell (du-t450s runs CDE, not zellij).
config-file = ?local

