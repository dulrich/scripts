# Colorscheme converted from .Xresources

foreground = #c5c8c6
background = #000000
cursor-color = #c5c8c6

palette = 0=#282a2e
palette = 1=#a54242
palette = 2=#649440
palette = 3=#de935f
palette = 4=#5f819d
palette = 5=#85678f
palette = 6=#5e8d87
