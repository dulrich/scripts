# Font

font-family = Bitstream Vera Sans Mono
font-family-bold = Bitstream Vera Sans Mono
font-family-italic = Bitstream Vera Sans Mono
font-family-bold-italic = Bitstream Vera Sans Mono
font-size = 14


# Window / appearance

window-padding-x = 2
window-padding-y = 2

gtk-titlebar = false
window-decoration = false

cursor-style = block
cursor-style-blink = true

scrollback-limit = 10240

# Your urxvt background had alpha:
# URxvt*background: rgba:0000/0000/0000/cccc
#
# cccc / ffff ~= 80% opacity.
# Start opaque first. Enable this only if you want the old transparency behavior.
#
background-opacity = 0.8

command = zellij -l welcome

